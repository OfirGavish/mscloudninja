// Main query - single pass through SigninLogs
SigninLogs
| where TimeGenerated >= ago(14d) and TimeGenerated <= now()
| where AuthenticationRequirement == "multiFactorAuthentication"
| where Status.errorCode == 0  // Only successful attempts
| extend 
    UserPrincipalName = tostring(UserPrincipalName),
    AuthDetails = todynamic(AuthenticationDetails),
    DeviceId = tostring(DeviceDetail.deviceId),
    DeviceCompliance = tostring(DeviceDetail.isCompliant),
    Location = strcat(tostring(LocationDetails.countryOrRegion), ", ", tostring(LocationDetails.city)),
    IsUnknownDevice = iff(isempty(DeviceDetail.deviceId), true, false)
| extend MFAMethod = iff(isnotempty(AuthDetails) and array_length(AuthDetails) > 0, tostring(AuthDetails[0].authenticationMethod), "")
| where isnotempty(MFAMethod)
| join kind=leftouter (
    // Historical data in a single subquery
    SigninLogs 
    | where TimeGenerated >= ago(60d) and TimeGenerated < ago(14d)
    | where AuthenticationRequirement == "multiFactorAuthentication"
    | where Status.errorCode == 0
    | summarize 
        HistoricalCount = count(),
        KnownMethods = make_set(tostring(todynamic(AuthenticationDetails)[0].authenticationMethod)),
        KnownLocations = make_set(strcat(tostring(LocationDetails.countryOrRegion), ", ", tostring(LocationDetails.city))),
        KnownDevices = make_set(tostring(DeviceDetail.deviceId))
        by UserPrincipalName
) on UserPrincipalName
// Evaluate multiple risk factors
| extend 
    IsRiskyMethod = MFAMethod has_any ("phone", "sms", "text", "email"),
    IsMethodAnomaly = isnotempty(KnownMethods) and not(KnownMethods has MFAMethod),
    IsLocationAnomaly = isnotempty(KnownLocations) and not(KnownLocations has Location) and isnotempty(Location),
    IsFirstTimeUser = isempty(HistoricalCount) or HistoricalCount < 5
// Calculate combined risk score
| extend RiskScore = case(
    IsFirstTimeUser, 40,
    IsRiskyMethod and IsLocationAnomaly, 90,
    IsRiskyMethod and IsMethodAnomaly, 85,
    IsRiskyMethod and IsUnknownDevice, 80,
    IsLocationAnomaly and IsMethodAnomaly, 75,
    IsRiskyMethod, 65,
    IsLocationAnomaly, 60,
    IsMethodAnomaly, 55,
    IsUnknownDevice, 45,
    20)
| where RiskScore > 40
// Create detailed anomaly type
| extend AnomalyType = case(
    IsRiskyMethod and IsLocationAnomaly, strcat("Risky Auth Method (", MFAMethod, ") from New Location (", Location, ")"),
    IsRiskyMethod and IsMethodAnomaly, strcat("Unusual Auth Method (", MFAMethod, ") for User"),
    IsRiskyMethod and IsUnknownDevice, strcat("Risky Auth Method (", MFAMethod, ") from Unknown Device"),
    IsLocationAnomaly and IsMethodAnomaly, "New Method from New Location",
    IsRiskyMethod, strcat("Risky Auth Method (", MFAMethod, ")"),
    IsLocationAnomaly, strcat("New Location (", Location, ")"),
    IsMethodAnomaly, strcat("Unusual Auth Method (", MFAMethod, ")"),
    IsUnknownDevice, "Unknown Device",
    "Other Risk")
// Output relevant fields
| project
    TimeGenerated,
    UserPrincipalName,
    AnomalyType,
    RiskScore,
    IPAddress,
    Location,
    MFAMethod,
    AppDisplayName,
    ResourceDisplayName,
    IsUnknownDevice,
    KnownMethods = iff(isempty(KnownMethods), "", tostring(KnownMethods)),
    KnownLocations = iff(isempty(KnownLocations), "", tostring(KnownLocations))
| order by RiskScore desc, TimeGenerated desc
